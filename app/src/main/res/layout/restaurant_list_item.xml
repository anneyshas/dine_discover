<?xml version="1.0" encoding="utf-8"?>
<!--Author: Holly Jacob-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wishlistRestaurantPic"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/noodles"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wishlistRestaurantName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TACO TACO"
                    android:textColor="@color/black"
                    android:textSize="26sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/wishlistRestaurantCuisine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Mexican"/>
                <TextView
                    android:id="@+id/wishlistRestaurantSuburb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Belconnen"/>

                <EditText
                    android:id="@+id/wishlistRestaurantUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="100"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="start|top"
                    android:text="www.tacotaco.com"
                    android:background="@android:color/transparent"
                    android:inputType="textMultiLine" />

            </LinearLayout>


        </LinearLayout>





    </RelativeLayout>

</LinearLayout>