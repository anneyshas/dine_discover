<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- First Layer: Comment TextView -->
    <TextView
        android:id="@+id/comment_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This is a comment"
        android:textSize="16sp"
        android:fontFamily="sans-serif-light"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="5dp"/>

    <!-- Second Layer: View more replies + Replies section -->
    <LinearLayout
        android:id="@+id/replies_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TextView to Show/Hide Replies -->
        <TextView
            android:id="@+id/view_more_replies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View more replies"
            android:textSize="14sp"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_marginBottom="8dp"
            android:visibility="visible" />

        <!-- Third Layer: Container for Replies (Initially hidden) -->
        <LinearLayout
            android:id="@+id/replies_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" >

            <!-- Example of dynamically added replies. Actual replies will be added programmatically. -->
            <TextView
                android:id="@+id/reply_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:fontFamily="sans-serif-light"
                android:textColor="@android:color/black"
                android:layout_marginLeft="10dp"
                android:layout_marginBottom="4dp" />

            <!-- EditText for typing a reply (Initially hidden) -->
            <EditText
                android:id="@+id/reply_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Write a reply..."
                android:visibility="gone"
                android:layout_marginTop="0dp"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="16dp"
                android:padding="8dp" />

            <!-- Button to submit the reply (Initially hidden) -->
            <Button
                android:id="@+id/reply_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reply"
                android:textSize="14sp"
                android:padding="6dp"
                android:minWidth="30dp"
                android:minHeight="5dp"
                android:visibility="gone"
                android:layout_marginTop="2dp"
                android:layout_marginLeft="310dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
